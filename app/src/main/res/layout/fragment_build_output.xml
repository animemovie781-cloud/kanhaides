<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="16dp"
    android:minHeight="400dp">

    <TextView
        android:id="@+id/tvBuildTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Build Output"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>
        
    <TextView
        android:id="@+id/tvBuildStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: IDLE"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:id="@+id/scrollViewLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvBuildLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel Build"
            android:textColor="#FF5555"
            style="?android:attr/buttonBarButtonStyle" />
            
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            
        <Button
            android:id="@+id/btnInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install APK"
            android:textColor="#55FF55"
            style="?android:attr/buttonBarButtonStyle"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
